# Werte fuer "docker compose" auf dem Server.
#
# Kopiere diese Datei neben die docker-compose.yml als ".env" und trag deine
# Werte ein. Sie enthaelt Passwoerter und gehoert nicht ins Repository.
#
#   cp docker/env.example .env
#   nano .env

# Deine Domaene, ohne Schema und ohne Schraegstrich am Ende.
# Sie muss per DNS auf diesen Server zeigen, sonst bekommt Caddy kein
# Zertifikat.
SITE_DOMAIN=leviz.example

# Dieselbe Domaene, diesmal vollstaendig. Daraus entstehen die kanonischen
# Adressen, hreflang und die Sitemap -- steht sie falsch, findet keine
# Suchmaschine die Seite.
NEXT_PUBLIC_SITE_URL=https://leviz.example

# Datenbank. Das Passwort waehlst du selbst; die Datenbank ist von aussen
# nicht erreichbar, aber ein schwaches Passwort bleibt trotzdem ein schwaches.
POSTGRES_USER=leviz
POSTGRES_PASSWORD=
POSTGRES_DB=leviz

# Anmelde-Geheimnis. Erzeugen mit:
#   openssl rand -base64 32
AUTH_SECRET=

# Dateispeicher. "local" legt die Fotos auf die Festplatte des Servers, in
# einem dauerhaften Docker-Speicher. Auf einem einzelnen Server ist das
# richtig; erst bei mehreren braucht es "s3".
STORAGE_DRIVER=local

# E-Mail. Solange "console" steht, werden Mails nur ins Protokoll geschrieben:
# Passwort-Zuruecksetzung und Willkommensmails kommen dann nirgends an.
#
# Fuer den Betrieb auf "smtp" stellen und das Postfach der eigenen Domaene
# eintragen. Bei Hostinger: smtp.hostinger.com, Port 465.
EMAIL_DRIVER=console
EMAIL_FROM=LEVIZ <info@levizz.com>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# SMS fuer die Anmeldung per Telefonnummer. "console" schreibt den Code ins
# Protokoll statt ihn zu verschicken.
SMS_DRIVER=console

# Zahlungen. "mock" laeuft vollstaendig, bewegt aber kein Geld.
PAYMENTS_DRIVER=mock

# Payten -- aus dem Haendlervertrag deiner Bank. Der Ladenschluessel ist ein
# Geheimnis: mit ihm liesse sich eine bezahlte Buchung faelschen.
PAYTEN_GATEWAY_URL=
PAYTEN_CLIENT_ID=
PAYTEN_STORE_KEY=
PAYTEN_STORE_TYPE=
