# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Die Vorlage gehoert ins Repository: ohne sie weiss niemand, welche
# Variablen die Anwendung erwartet.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

# Lokales PostgreSQL-Datenverzeichnis (npm run db:start)
.postgres/

# Generierter Prisma-Client
/lib/generated/

# Hochgeladene Bilder der Entwicklungsumgebung
/public/uploads/

# Profil des Aufnahme-Browsers (npm run brand:shots)
/.chrome-capture/

# Zwischendateien des Videoschnitts (npm run brand:video)
/.video-work/

# Ergebnisse der End-zu-End-Tests
/test-results/
/playwright-report/

# Versehentlich im Projektordner gelandete Downloads
/Download.*
