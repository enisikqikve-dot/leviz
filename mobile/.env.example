# Wohin die App ihre Anfragen schickt. Ohne Angabe: die Live-Seite.
#
# Fuer die Entwicklung gegen den lokalen Server auf dem Telefon muss hier
# die Adresse des Rechners im WLAN stehen, nicht localhost -- das Telefon
# meint mit localhost sich selbst.
#   EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=https://levizz.com

# Nutzungsdaten und Absturzberichte (PostHog, EU). Kommt von
# `npx eas integrations:posthog:connect` nach .env.local -- ohne Schluessel
# wird nichts erfasst, und die App sagt das im Protokoll.
# EXPO_PUBLIC_POSTHOG_API_KEY=phc_...
# EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com


# Anmeldung mit Google-Konto. Ohne die Werte gibt es den Knopf nicht.
# Web-Client-ID: dieselbe wie AUTH_GOOGLE_ID auf dem Server -- auf sie
# stellt Google das ID-Token aus, das der Server prueft.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# iOS-Client-ID aus der Google-Konsole (Typ iOS, Bundle-ID com.levizz.app)
# und ihr umgedrehtes URL-Schema, das beim Bauen in die App kommt:
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=1234567890-xyz.apps.googleusercontent.com
# GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.1234567890-xyz
# Apple braucht nichts: der Knopf erscheint auf jedem iPhone.
