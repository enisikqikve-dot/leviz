# ---------------------------------------------------------------------------
# LEVIZ – Umgebungsvariablen
# Kopiere diese Datei nach `.env` und trage deine Werte ein.
# `.env` ist über .gitignore ausgeschlossen und gehört niemals ins Repository.
# ---------------------------------------------------------------------------

# Datenbank ------------------------------------------------------------------
# Lokale Entwicklung: `npm run db:init` legt einen eigenen PostgreSQL-Cluster
# unter .postgres/data an und startet ihn auf Port 5433.
DATABASE_URL="postgresql://leviz:leviz_dev@127.0.0.1:5433/leviz?schema=public"

# Supabase (Projekt "leviz", Region eu-central-1) -----------------------------
# Das Passwort steht nur im Supabase-Dashboard:
#   Project Settings → Database → Connection string → URI
# Falls es nicht mehr bekannt ist, dort auf "Reset database password".
#
# Für die Anwendung die gepoolte Verbindung nehmen (Port 6543):
# DATABASE_URL="postgresql://postgres.xupfqllspnlvuiakaatk:PASSWORT@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# Für Migrationen und den Seed die direkte Verbindung (Port 5432); der Pooler
# kann keine Transaktionen über mehrere Anweisungen halten:
# DIRECT_URL="postgresql://postgres.xupfqllspnlvuiakaatk:PASSWORT@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Anwendung ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Authentifizierung ----------------------------------------------------------
# Erzeuge ein Geheimnis mit: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# GitHub-Anmeldung (optional – ohne Werte wird der Anbieter ausgeblendet)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Dateispeicher --------------------------------------------------------------
# Ohne Werte schreibt LEVIZ Uploads nach ./public/uploads (nur Entwicklung).
STORAGE_DRIVER="local"          # local | s3
STORAGE_ENDPOINT=""             # z. B. https://<account>.r2.cloudflarestorage.com
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET=""
STORAGE_PUBLIC_URL=""

# Zahlungen ------------------------------------------------------------------
# Ohne Schlüssel läuft der Mock-Anbieter; Buchungen funktionieren, ohne Geld zu bewegen.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# E-Mail ---------------------------------------------------------------------
# Ohne Schlüssel werden Mails ins Terminal geschrieben.
EMAIL_DRIVER="console"          # console | resend | smtp
EMAIL_FROM="LEVIZ <no-reply@leviz.example>"
RESEND_API_KEY=""
SMTP_URL=""

# SMS (Anmeldung per Telefonnummer) ------------------------------------------
# Ohne Schlüssel wird der Einmalcode ins Terminal geschrieben.
SMS_DRIVER="console"            # console | twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# Karten ---------------------------------------------------------------------
# Ohne Schlüssel werden Standorte aus den Stadt-Koordinaten der Datenbank gelesen.
NEXT_PUBLIC_MAPS_PROVIDER="static"   # static | mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=""

# KI -------------------------------------------------------------------------
# "local" rechnet und formuliert selbst und braucht keinen Schlüssel.
AI_DRIVER="local"               # local | openai
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
